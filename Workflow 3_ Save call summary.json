    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst summary = body.analysis?.transcript_summary ?? '';\n\n// Extract order_id - find any number pattern like #1042, 1042, etc.\nconst orderMatch = summary.match(/#?\\d{3,6}/);\nconst order_id = orderMatch ? orderMatch[0] : 'Не вказано';\n\n// Extract customer name - find \"user, NAME,\" pattern\nconst nameMatch = summary.match(/[Tt]he user,?\\s+([A-ZА-ЯІЇЄ][a-zа-яіїє]+)/);\nconst customer_name = nameMatch ? nameMatch[1] : 'Невідомий';\n\nreturn [{\n  json: {\n    ...body,\n    extracted_order_id: order_id,\n    extracted_customer_name: customer_name,\n  }\n}];"
      },
